# xAI
XAI_API_KEY=
XAI_WEBHOOK_SECRET=
XAI_SIP_PHONE_NUMBER=
XAI_SIP_AUTH_USERNAME=
XAI_SIP_AUTH_PASSWORD=
# Live-call REST control bounds; websocket setup has its own bounded timeout.
XAI_CONNECT_TIMEOUT_SECONDS=3
XAI_HTTP_TIMEOUT_SECONDS=10
# Post-call extraction gets a longer per-request bound than live-call control requests.
XAI_EXTRACTION_TIMEOUT_SECONDS=30
# Reuse the xAI TLS connection between sporadic calls.
XAI_KEEPALIVE_EXPIRY_SECONDS=60

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_HTTP_TIMEOUT_SECONDS=10

# Single owner and Poke authentication
OWNER_PHONE_E164=
ALLOWED_POKE_USER_ID=
MCP_BEARER_TOKEN=
DEBUG_API_TOKEN=
DEPLOY_GUARD_TOKEN=

# Public deployment
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./poke_call.db
ALLOWED_COUNTRY_CODES=+1

# Fixed/release-gated model configuration
REALTIME_MODEL=grok-voice-think-fast-1.0
INPUT_TRANSCRIPTION_MODEL=grok-transcribe
SERVER_VAD_SILENCE_DURATION_MS=700
SERVER_VAD_PREFIX_PADDING_MS=333
EXTRACTOR_MODEL=grok-4.3

# Optional non-canonical push
POKE_PUSH_ENABLED=false
# POKE_API_KEY=
