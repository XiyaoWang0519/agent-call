# Copy to .env.local (gitignored). Never commit filled env files.
# Do not set ALLOWED_COUNTRY_CODES in this file. pydantic-settings JSON-decodes
# list-typed fields, so ALLOWED_COUNTRY_CODES=+1 crashes boot. Omit it and rely
# on the default ["+1"]. For a non-default allowlist, set a JSON list in the
# process environment / secrets (for example ALLOWED_COUNTRY_CODES=["+1"]).

# ---------------------------------------------------------------------------
# Profile
# ---------------------------------------------------------------------------
# evaluation: dummy credentials, /healthz + prepare_phone_call, start disabled.
# live: requires every core field below; can place a real billable call.
# Settings and `uvicorn` default to live (this variable unset). Dummy paths set
# evaluation explicitly (`--profile evaluation`, Compose, or this variable).
# `agent-call serve` with any core credential (this file or the process
# environment) and no explicit profile is refused — pass --profile live
# (billable) or --profile evaluation. Bind override is CLI `--unsafe-bind` only.
# AGENT_CALL_PROFILE=evaluation

# ---------------------------------------------------------------------------
# Core (required for a live boot)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
OWNER_PHONE_E164=
# Display name policy.py requires ContextPacket.owner.display_name to match.
# OWNER_DISPLAY_NAME=the owner
ALLOWED_AGENT_USER_ID=
MCP_BEARER_TOKEN=
DEBUG_API_TOKEN=
DEPLOY_GUARD_TOKEN=
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./agent_call.db

# ---------------------------------------------------------------------------
# Optional features
# ---------------------------------------------------------------------------
# Optional web search. Leave blank to run calls without search.
EXA_API_KEY=

# Enable OAuth for ChatGPT and Claude web at /connect/mcp/.
# Self-hosted, single-owner only; /mcp/ remains available to header-based clients.
# MCP_OAUTH_ENABLED=false
# Hash only. Generate with: uv run python scripts/hash_mcp_oauth_owner_secret.py
# MCP_OAUTH_OWNER_SECRET_HASH=
# openssl rand -hex 32
# MCP_OAUTH_SIGNING_KEY=
# openssl rand -hex 32
# MCP_OAUTH_STORAGE_ENCRYPTION_KEY=
# MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_OAUTH_REFRESH_TOKEN_TTL_DAYS=90
# MCP_OAUTH_AUTH_CODE_TTL_SECONDS=300

# Optional non-canonical push to an OpenClaw gateway webhook (POST /hooks/agent).
# Hermes Agent has no inbound webhook today — leave AGENT_PUSH_ENABLED=false and
# rely on wait_for_call_event polling.
# AGENT_WEBHOOK_URL must be HTTPS (http:// only for localhost) and is required
# together with AGENT_WEBHOOK_TOKEN when AGENT_PUSH_ENABLED=true.
AGENT_PUSH_ENABLED=false
# AGENT_WEBHOOK_URL=https://your-gateway.example/hooks/agent
# AGENT_WEBHOOK_TOKEN=

# Mid-call ask_agent channel (off by default until canary)
ASK_AGENT_ENABLED=false
# ASK_AGENT_ANSWER_TIMEOUT_SECONDS=60
# ASK_AGENT_MAX_QUESTIONS_PER_CALL=5
# WAIT_FOR_CALL_EVENT_MAX_SECONDS=20

# Hold-and-wait: detect hold music/IVR queues and go quiet until a human returns
# (off by default until canary)
HOLD_DETECTION_ENABLED=false
# HOLD_MAX_SECONDS=300

# ---------------------------------------------------------------------------
# Tuning (safe defaults; optional)
# ---------------------------------------------------------------------------
OPENAI_CONNECT_TIMEOUT_SECONDS=3
OPENAI_HTTP_TIMEOUT_SECONDS=10
OPENAI_EXTRACTION_TIMEOUT_SECONDS=30
OPENAI_KEEPALIVE_EXPIRY_SECONDS=60
EXA_SEARCH_TIMEOUT_SECONDS=3
TWILIO_HTTP_TIMEOUT_SECONDS=10
# GPT-Live handles full-duplex speech and transcription natively.
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
LIVE_BACKEND_MODEL=gpt-5.6-terra
LIVE_BACKEND_REASONING_EFFORT=low
# LIVE_SESSION_CLOSE_TIMEOUT_SECONDS=15
EXTRACTOR_MODEL=gpt-5.4-mini-2026-03-17
# LIVE_PRICE_PER_MINUTE=0.05
# BACKEND_INPUT_PRICE_PER_1M=2.00
# BACKEND_CACHED_INPUT_PRICE_PER_1M=0.20
# BACKEND_OUTPUT_PRICE_PER_1M=12.00
# EXTRACTOR_INPUT_PRICE_PER_1M=0.75
# EXTRACTOR_OUTPUT_PRICE_PER_1M=4.50
# TWILIO_VOICE_PRICE_PER_MINUTE=0.014
