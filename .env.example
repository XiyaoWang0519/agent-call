OPENAI_PROJECT_ID=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=

# Single owner and Poke authentication
OWNER_PHONE_E164=
ALLOWED_POKE_USER_ID=
MCP_BEARER_TOKEN=
