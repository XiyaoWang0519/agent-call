# OpenAI
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=
# Live-call REST control bounds; websocket setup has its own bounded timeout.
OPENAI_CONNECT_TIMEOUT_SECONDS=3
OPENAI_HTTP_TIMEOUT_SECONDS=10
# Post-call extraction gets a longer per-request bound than live-call control requests.
OPENAI_EXTRACTION_TIMEOUT_SECONDS=30
# Reuse the OpenAI TLS connection between sporadic calls.
OPENAI_KEEPALIVE_EXPIRY_SECONDS=60

# Exa web search for the in-call voice agent
EXA_API_KEY=
EXA_SEARCH_TIMEOUT_SECONDS=3

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_HTTP_TIMEOUT_SECONDS=10

# Single owner and Poke authentication
OWNER_PHONE_E164=
# Display name policy.py requires ContextPacket.owner.display_name to match; defaults to "Irvin".
# OWNER_DISPLAY_NAME=Irvin
ALLOWED_POKE_USER_ID=
MCP_BEARER_TOKEN=
DEBUG_API_TOKEN=
DEPLOY_GUARD_TOKEN=

# Public deployment
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./poke_call.db
ALLOWED_COUNTRY_CODES=+1

# Fixed/release-gated model configuration
INPUT_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# INPUT_TRANSCRIPTION_DELAY=low
# Defaults to auto (OpenAI's medium-eagerness behavior). Set to high for quicker turn completion.
# SEMANTIC_VAD_EAGERNESS=auto
EXTRACTOR_MODEL=gpt-5.4-nano-2026-03-17
MINI_MODELS_ENABLED=false

# Optional non-canonical push
POKE_PUSH_ENABLED=false
# POKE_API_KEY=

# Mid-call ask_poke channel (off by default until canary)
ASK_POKE_ENABLED=false
# ASK_POKE_ANSWER_TIMEOUT_SECONDS=30
# ASK_POKE_MAX_QUESTIONS_PER_CALL=5
# WAIT_FOR_CALL_EVENT_MAX_SECONDS=20
