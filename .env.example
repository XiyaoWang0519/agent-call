# OpenAI
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_PROJECT_ID=
# Live-call REST control bounds; websocket setup has its own bounded timeout.
OPENAI_CONNECT_TIMEOUT_SECONDS=3
OPENAI_HTTP_TIMEOUT_SECONDS=10
# Post-call extraction gets a longer per-request bound than live-call control requests.
OPENAI_EXTRACTION_TIMEOUT_SECONDS=30
# Reuse the OpenAI TLS connection between sporadic calls.
OPENAI_KEEPALIVE_EXPIRY_SECONDS=60

# Exa web search for the in-call voice agent
EXA_API_KEY=
EXA_SEARCH_TIMEOUT_SECONDS=3

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
TWILIO_HTTP_TIMEOUT_SECONDS=10

# Single owner and Poke authentication
OWNER_PHONE_E164=
# Display name policy.py requires ContextPacket.owner.display_name to match; defaults to "the owner".
# OWNER_DISPLAY_NAME=the owner
ALLOWED_POKE_USER_ID=
MCP_BEARER_TOKEN=
DEBUG_API_TOKEN=
DEPLOY_GUARD_TOKEN=

# Public deployment
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./poke_call.db
# Do not set ALLOWED_COUNTRY_CODES in dotenv files. pydantic-settings JSON-decodes
# list-typed fields, so ALLOWED_COUNTRY_CODES=+1 crashes boot. Omit it and rely on
# the default ["+1"]. For non-default allowlists, set a JSON list in the process
# environment / secrets (e.g. ALLOWED_COUNTRY_CODES=["+1"]).
# ALLOWED_COUNTRY_CODES=["+1"]


# Fixed/release-gated model configuration
INPUT_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# INPUT_TRANSCRIPTION_DELAY=low
# Defaults to auto (OpenAI's medium-eagerness behavior). Set to high for quicker turn completion.
# SEMANTIC_VAD_EAGERNESS=auto
EXTRACTOR_MODEL=gpt-5.4-nano-2026-03-17
MINI_MODELS_ENABLED=false

# Optional non-canonical push
POKE_PUSH_ENABLED=false
# POKE_API_KEY=

# Mid-call ask_poke channel (off by default until canary)
ASK_POKE_ENABLED=false
# ASK_POKE_ANSWER_TIMEOUT_SECONDS=60
# ASK_POKE_MAX_QUESTIONS_PER_CALL=5
# WAIT_FOR_CALL_EVENT_MAX_SECONDS=20

# Hold-and-wait: detect hold music/IVR queues and go quiet until a human returns
# (off by default until canary)
HOLD_DETECTION_ENABLED=false
# HOLD_MAX_SECONDS=300

# Cost tracking (estimated pricing, USD)
# REALTIME_TEXT_INPUT_PRICE_PER_1M=4.00
# REALTIME_AUDIO_INPUT_PRICE_PER_1M=32.00
# REALTIME_CACHED_TEXT_INPUT_PRICE_PER_1M=0.40
# REALTIME_CACHED_AUDIO_INPUT_PRICE_PER_1M=0.40
# REALTIME_TEXT_OUTPUT_PRICE_PER_1M=16.00
# REALTIME_AUDIO_OUTPUT_PRICE_PER_1M=64.00
# EXTRACTOR_INPUT_PRICE_PER_1M=0.05
# EXTRACTOR_OUTPUT_PRICE_PER_1M=0.40
# TWILIO_VOICE_PRICE_PER_MINUTE=0.014
