# Copy to .env.live-phone (ignored). These are harness settings, not production settings.
# Use one isolated Twilio account/subaccount with three owned numbers.
LIVE_TEST_PUBLIC_URL=https://phones.example.com
LIVE_TEST_APP_URL=https://agent-call-test.example.com
LIVE_TEST_INSTANCE_ID=replace-with-unique-test-instance-id
LIVE_TEST_TOKEN=replace-with-at-least-32-random-characters
LIVE_TEST_MCP_TOKEN=replace-with-test-app-mcp-token
LIVE_TEST_AGENT_USER_ID=replace-with-test-app-agent-user-id
LIVE_TEST_DEBUG_TOKEN=replace-with-test-app-debug-token
LIVE_TEST_TWILIO_ACCOUNT_SID=replace-with-isolated-account-sid
LIVE_TEST_TWILIO_AUTH_TOKEN=replace-with-isolated-account-auth-token
LIVE_TEST_OPENAI_API_KEY=replace-with-authorized-test-api-key
LIVE_TEST_CALLER_NUMBER=+14155550100
LIVE_TEST_CALLEE_NUMBER=+14155550101
LIVE_TEST_OWNER_NUMBER=+14155550102
LIVE_TEST_ARTIFACTS=.live-phone
LIVE_TEST_MAX_SUITE_SECONDS=5400
LIVE_TEST_TTS_MODEL=gpt-4o-mini-tts
LIVE_TEST_ASR_MODEL=gpt-4o-mini-transcribe
LIVE_TEST_VOICE=alloy
